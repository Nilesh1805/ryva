# RYVA COLLECTION — Environment Configuration Example
# Copy this file to .env and configure the respective API keys and endpoints

# Application Environment
VITE_APP_ENV=development

# Storefront URL
VITE_SITE_URL=http://localhost:5173

# Official Instagram Integration
VITE_INSTAGRAM_URL=https://instagram.com/ryvacollection01/
VITE_INSTAGRAM_HANDLE=@ryvacollection01

# WhatsApp Concierge Number (Include country code without '+' or spaces, e.g., 919876543210)
VITE_WHATSAPP_NUMBER=919876543210

# Backend Integration Endpoints (For future production services)
# VITE_API_BASE_URL=https://api.ryvacollection.com/v1
